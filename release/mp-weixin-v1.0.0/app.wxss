page{min-height:100%;background:#f7f3ea;color:#102b4c;font-family:PingFang SC,Microsoft YaHei,sans-serif;font-size:28rpx}view,text,button,input,scroll-view,image{box-sizing:border-box}button{margin:0;padding:0;line-height:inherit;background:none}button:after{border:0}::-webkit-scrollbar{width:0;height:0;background:transparent}.page-shell{min-height:100vh;padding:32rpx 32rpx 176rpx;background:#f7f3ea}.display-serif{font-family:STSong,SimSun,serif}.muted{color:#7e848b}.eyebrow{color:#df4f3f;font-weight:700;letter-spacing:2rpx}.primary-button{min-height:96rpx;padding:0 36rpx;border-radius:28rpx;background:#758ddd;color:#fff;display:flex;align-items:center;justify-content:center;gap:16rpx;font-size:32rpx;font-weight:700;box-shadow:0 16rpx 34rpx rgba(104,128,211,.22)}.secondary-button{min-height:84rpx;padding:0 28rpx;border:2rpx solid #deddd7;border-radius:24rpx;color:#102b4c;display:flex;align-items:center;justify-content:center;font-weight:700}.surface{background:rgba(255,253,248,.72);border:1rpx solid #deddd7;border-radius:28rpx}.section-heading{font-family:STSong,SimSun,serif;font-size:38rpx;line-height:1.25;font-weight:700}.touch-row{min-height:88rpx}@media (min-width: 600px){html{font-size:16px!important}body{background:#e8e4dc}uni-page-body{width:390px;min-height:100vh;margin:0 auto;overflow:hidden;box-shadow:0 0 36px rgba(16,43,76,.08)}}
page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}